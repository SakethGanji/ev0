{
  "name": "editor-core",
  "version": "0.0.1",
  "description": "Self-contained Tiptap v3 rich-text editor for Angular 17+ (standalone components, signals). Drop-in <tip-editor> plus building blocks for custom layouts.",
  "keywords": [
    "angular",
    "tiptap",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "standalone",
    "signals"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/extensions": "^3.0.0",
    "@tiptap/extension-character-count": "^3.0.0",
    "@tiptap/extension-drag-handle": "^3.0.0",
    "@tiptap/extension-file-handler": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-invisible-characters": "^3.0.0",
    "@tiptap/extension-list": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/extension-typography": "^3.0.0",
    "turndown": "^7.0.0",
    "html-docx-js-typescript": "^0.1.5",
    "marked": "^14.0.0 || ^18.0.0",
    "mammoth": "^1.7.0"
  },
  "peerDependenciesMeta": {
    "turndown": { "optional": true },
    "html-docx-js-typescript": { "optional": true },
    "marked": { "optional": true },
    "mammoth": { "optional": true }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false
}
