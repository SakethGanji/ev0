{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": ".",
  "projects": {
    "editor-core": {
      "projectType": "library",
      "root": "editor-core",
      "sourceRoot": "editor-core/src",
      "prefix": "tip",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "editor-core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "editor-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "editor-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "editor-core/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
